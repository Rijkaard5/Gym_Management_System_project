{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🏋️ Start GymPro",
      "type": "shell",
      "command": "cd backend && npm install && node server.js",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new",
        "showReuseMessage": false
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "🔄 Dev Mode (auto-restart)",
      "type": "shell",
      "command": "cd backend && npm install && npx nodemon server.js",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
